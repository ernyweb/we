<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC1a1a2e"
    android:padding="16dp"
    android:elevation="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎙️ SES EFEKTİ SEÇ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:paddingBottom="12dp"/>

    <TextView
        android:id="@+id/btnOverlayRobot"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🤖 Robot"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#4CAF50"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayWoman"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="👩 Kadın"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#E91E63"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayMan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="👨 Erkek"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#2196F3"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayChild"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="👶 Çocuk"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayMonster"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="👹 Canavar"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#9C27B0"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayOff"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="❌ Kapat"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:background="#666666"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"/>

    <TextView
        android:id="@+id/btnOverlayClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="✕ İptal"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:background="#333333"
        android:gravity="center"
        android:clickable="true"/>

</LinearLayout>
