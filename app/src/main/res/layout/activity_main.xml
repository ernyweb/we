<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0f172a">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Call Recorder"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#e2e8f0"
        android:gravity="center"
        android:padding="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzinler bekleniyor"
        android:textSize="14sp"
        android:textColor="#cbd5e1"
        android:padding="4dp" />

    <Button
        android:id="@+id/btnRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzinleri ver ve servisi başlat"
        android:textAllCaps="false"
        android:background="#2563eb"
        android:textColor="#ffffff"
        android:padding="12dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙ Ayarlar"
        android:textAllCaps="false"
        android:background="#10b981"
        android:textColor="#ffffff"
        android:padding="12dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kayıtlar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#e2e8f0"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Henüz kayıt yok"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:visibility="gone"
        android:padding="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recordingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111827" />

</LinearLayout>
