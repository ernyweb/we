<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ Voice Changer"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesinizi değiştirin ve eğlenin!"
            android:textSize="14sp"
            android:textColor="#aaaaaa"
            android:gravity="center"
            android:paddingBottom="24dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kayıt yapmaya hazır"
            android:textSize="16sp"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:background="#2a2a3e"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textStyle="bold"/>

        <!-- Recording Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🎤\nKaydet"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#f44336"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="⏹️\nDurdur"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#FF5722"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Real-Time Mode Button -->
        <Button
            android:id="@+id/btnRealtime"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="🎧 Real-Time: OFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#666666"
            android:layout_marginBottom="12dp"/>

        <!-- System-Wide Mode Button -->
        <Button
            android:id="@+id/btnSystemWide"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="🌐 SİSTEM GENELİ: OFF\n(WhatsApp, Oyunlar, Aramalar)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Voice Effects Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ses Efektleri:"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- Voice Effects Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnRobot"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="🤖 Robot"
                    android:textSize="14sp"
                    android:backgroundTint="#BBBBBB"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnWoman"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="👩 Kadın"
                    android:textSize="14sp"
                    android:backgroundTint="#BBBBBB"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnMan"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="👨 Erkek"
                    android:textSize="14sp"
                    android:backgroundTint="#BBBBBB"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnChild"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="👶 Çocuk"
                    android:textSize="14sp"
                    android:backgroundTint="#BBBBBB"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Row 3 -->
            <Button
                android:id="@+id/btnMonster"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="👹 Canavar"
                android:textSize="14sp"
                android:backgroundTint="#BBBBBB"/>
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="▶️ Oynat"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="📤 Paylaş"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Recordings List Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kayıtlarım:"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- Recordings List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecordings"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#2a2a3e"
            android:padding="8dp"/>

    </LinearLayout>

</ScrollView>
