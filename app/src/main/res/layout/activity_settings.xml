<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Geri"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ayarlar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:gravity="center"/>

        <View
            android:layout_width="80dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bildirimler"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bildirim göster\n(Call Recorder hazır)"
                    android:textSize="16sp"
                    android:textColor="#666"/>

                <Switch
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bildirimler kapatıldığında servis arka planda çalışmaya devam eder."
                android:textSize="12sp"
                android:textColor="#999"
                android:paddingTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kayıt Ayarları"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kayıt etkin\n(Çağrıları kaydet)"
                    android:textSize="16sp"
                    android:textColor="#666"/>

                <Switch
                    android:id="@+id/switchRecording"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Audio Format -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ses Formatı"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerFormat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingBottom="8dp"/>

            <!-- Bitrate -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bitrate (Kalite)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerBitrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingBottom="8dp"/>

            <!-- Sample Rate -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Örnekleme Hızı"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerSampleRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingBottom="8dp"/>

            <!-- Channels -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kanal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerChannels"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 3GP: Çağrılar için optimize, daha uyumlu\n• MP4: Daha kaliteli ama bazı cihazlarda çalışmayabilir\n• Yüksek bitrate = Daha iyi kalite ama daha büyük dosya\n• Mono: Ses kaydı için yeterli, Stereo: Müzik için"
                android:textSize="11sp"
                android:textColor="#999"
                android:paddingTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
