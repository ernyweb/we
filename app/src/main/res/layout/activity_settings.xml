<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#ffffff">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Optimizasyon Ayarları"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#000" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Enable Optimization -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Optimizasyonu Etkinleştir"
                    android:textSize="16sp"
                    android:textColor="#000" />

                <Switch
                    android:id="@+id/enableOptimization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- High Performance Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yüksek Performans Modu"
                    android:textSize="16sp"
                    android:textColor="#000" />

                <Switch
                    android:id="@+id/enableHighPerformance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Network Boost -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ağ Hızlandırıcısı (Ping)"
                    android:textSize="16sp"
                    android:textColor="#000" />

                <Switch
                    android:id="@+id/enableNetworkBoost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#e0e0e0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Graphics Quality -->
            <TextView
                android:id="@+id/graphicsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grafik Kalitesi: %30"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:padding="8dp" />

            <SeekBar
                android:id="@+id/graphicsQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp" />

            <!-- Refresh Rate -->
            <TextView
                android:id="@+id/refreshLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh Rate: 30Hz"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:padding="8dp"
                android:layout_marginTop="16dp" />

            <SeekBar
                android:id="@+id/refreshRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp" />

            <!-- Ping Booster -->
            <TextView
                android:id="@+id/pingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ping Booster: -0ms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:padding="8dp"
                android:layout_marginTop="16dp" />

            <SeekBar
                android:id="@+id/pingBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
